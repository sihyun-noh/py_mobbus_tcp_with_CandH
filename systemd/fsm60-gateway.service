[Unit]
Description=FSM60 Modbus TCP to MQTT Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/fsm60-gateway --config __APP_DIR__/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
